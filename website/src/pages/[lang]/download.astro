---
import { LANGS, type Lang, ui, url } from "../../i18n/ui";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
    ASSET_PATTERNS,
    formatSize,
    getLatestRelease,
    LATEST_RELEASE_API,
    LATEST_RELEASE_URL,
    type PlatformId,
    RELEASES_URL,
} from "../../lib/release";

export function getStaticPaths() {
    return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang].download;
const release = await getLatestRelease();
const date = release
    ? new Intl.DateTimeFormat(lang, { dateStyle: "long" }).format(new Date(release.publishedAt))
    : "";
const lead = release
    ? t.lead.replace("{version}", release.version).replace("{date}", date)
    : t.leadUnknown;

const groups: { os: "windows" | "mac" | "linux"; title: string; guide: string; ids: PlatformId[] }[] = [
    { os: "windows", title: "Windows", guide: "install/windows/", ids: ["windows"] },
    { os: "mac", title: "macOS", guide: "install/macos/", ids: ["macArm", "macIntel"] },
    { os: "linux", title: "Linux", guide: "install/linux/", ids: ["appImage", "deb"] },
];
---

<SiteLayout lang={lang} path="download/" title={ui[lang].meta.downloadTitle} description={ui[lang].meta.downloadDescription}>
    <section class="dl-head">
        <div class="wrap">
            <h1 class="display">{t.title}</h1>
            <p class="lead">{lead}</p>
            <p class="dl-mobile" hidden data-mobile-note>{t.mobile}</p>
        </div>
    </section>

    <section class="dl-list" data-release-missing={release ? undefined : "true"} data-api={LATEST_RELEASE_API} data-patterns={JSON.stringify(ASSET_PATTERNS)}>
        <div class="wrap">
            {
                groups.map((group) => (
                    <div class="dl-group" data-os={group.os}>
                        <div class="dl-group-head">
                            <h2>{group.title}</h2>
                            <span class="dl-badge" hidden>
                                {t.recommended}
                            </span>
                            <a class="text-link dl-guide" href={url(`${lang}/${group.guide}`)}>
                                {t.guide}
                            </a>
                        </div>
                        {group.ids.map((id) => {
                            const asset = release?.assets[id];
                            return (
                                <div class="dl-row" data-platform={id}>
                                    <div class="dl-info">
                                        <span class="dl-name">{t.platforms[id].name}</span>
                                        <span class="dl-detail">{t.platforms[id].detail}</span>
                                    </div>
                                    <div class="dl-file mono">
                                        <span data-file-name>{asset?.name ?? ""}</span>
                                        <span data-file-size>{asset ? formatSize(asset.size) : ""}</span>
                                        {asset?.sha256 && (
                                            <details class="dl-sum">
                                                <summary>{t.checksum}</summary>
                                                <code>{asset.sha256}</code>
                                            </details>
                                        )}
                                    </div>
                                    <a class="btn btn-ghost dl-btn" href={asset?.url ?? LATEST_RELEASE_URL} data-file-link>
                                        {t.button}
                                    </a>
                                </div>
                            );
                        })}
                    </div>
                ))
            }
            <p class="dl-older">
                <a class="text-link" href={RELEASES_URL}>{t.olderVersions}</a>
            </p>
        </div>
    </section>

    <section class="section dl-notes">
        <div class="wrap">
            <h2 class="h2">{t.notesTitle}</h2>
            <ul>
                {
                    t.notes.map((note) => (
                        <li>
                            <h3>{note.title}</h3>
                            <p>{note.text}</p>
                        </li>
                    ))
                }
            </ul>
            <div class="dl-next">
                <div>
                    <h3>{t.next.title}</h3>
                    <p>{t.next.text}</p>
                </div>
                <a class="btn btn-primary" href={url(`${lang}/start/first-steps/`)}>{t.next.link}</a>
            </div>
        </div>
    </section>
</SiteLayout>

<script>
    import { detectOs } from "../../lib/detect-os";

    const os = detectOs();
    if (os === "mobile") {
        document.querySelector<HTMLElement>("[data-mobile-note]")?.removeAttribute("hidden");
    } else if (os !== "unknown") {
        const group = document.querySelector<HTMLElement>(`.dl-group[data-os="${os}"]`);
        if (group) {
            group.classList.add("is-recommended");
            group.querySelector<HTMLElement>(".dl-badge")?.removeAttribute("hidden");
            group.parentElement?.prepend(group);
            // Apple Silicon and AppImage are the usual choice on their systems.
            group.querySelector(".dl-btn")?.classList.replace("btn-ghost", "btn-primary");
        }
    }

    // If GitHub could not be reached while the site was built, ask its API from the browser.
    const list = document.querySelector<HTMLElement>("[data-release-missing]");
    if (list?.dataset.api && list.dataset.patterns) {
        const patterns = JSON.parse(list.dataset.patterns) as Record<string, string>;
        fetch(list.dataset.api, { headers: { Accept: "application/vnd.github+json" } })
            .then((response) => (response.ok ? response.json() : null))
            .then((data: { assets?: { name: string; browser_download_url: string; size: number }[] } | null) => {
                if (!data?.assets) return;
                for (const [id, pattern] of Object.entries(patterns)) {
                    const asset = data.assets.find((a) => new RegExp(pattern).test(a.name));
                    const row = document.querySelector<HTMLElement>(`[data-platform="${id}"]`);
                    if (!asset || !row) continue;
                    row.querySelector<HTMLAnchorElement>("[data-file-link]")!.href = asset.browser_download_url;
                    row.querySelector("[data-file-name]")!.textContent = asset.name;
                    row.querySelector("[data-file-size]")!.textContent = `${Math.round(asset.size / 1048576)} MB`;
                }
            })
            .catch(() => {
                // The buttons already point at the latest release on GitHub.
            });
    }
</script>

<style>
    .dl-head {
        padding: clamp(3rem, 7vw, 5rem) 0 2.5rem;
    }
    .dl-head .display {
        font-size: clamp(2.3rem, 5vw, 3.4rem);
    }
    .dl-head .lead {
        margin-top: 1rem;
    }
    .dl-mobile {
        margin-top: 1.5rem;
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--onyx-accent);
        background: var(--onyx-accent-soft);
    }
    .dl-list {
        padding-bottom: 4rem;
    }
    .dl-group {
        border: 1px solid var(--onyx-line);
        border-radius: var(--onyx-radius-lg);
        background: var(--onyx-surface);
        margin-bottom: 1.25rem;
        overflow: hidden;
    }
    .dl-group.is-recommended {
        border-color: var(--onyx-accent-line);
        box-shadow: 0 0 0 1px var(--onyx-accent-line);
    }
    .dl-group-head {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--onyx-line);
        background: var(--onyx-bg-2);
    }
    .dl-group-head h2 {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 600;
        letter-spacing: -0.01em;
    }
    .dl-badge {
        font: 500 0.72rem var(--onyx-font-mono);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 3px;
        background: var(--onyx-accent);
        color: #fff;
    }
    .dl-guide {
        margin-left: auto;
        font-size: 0.9rem;
    }
    .dl-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto;
        gap: 1.5rem;
        align-items: center;
        padding: 1.2rem 1.5rem;
    }
    .dl-row + .dl-row {
        border-top: 1px solid var(--onyx-line);
    }
    .dl-info {
        display: grid;
    }
    .dl-name {
        font-weight: 600;
    }
    .dl-detail {
        font-size: 0.9rem;
        color: var(--onyx-text-2);
    }
    .dl-file {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 0.9rem;
        font-size: 0.8rem;
        color: var(--onyx-text-3);
        min-width: 0;
    }
    .dl-file [data-file-name] {
        overflow-wrap: anywhere;
    }
    .dl-sum {
        width: 100%;
    }
    .dl-sum summary {
        cursor: pointer;
    }
    .dl-sum code {
        display: block;
        margin-top: 0.3rem;
        overflow-wrap: anywhere;
        color: var(--onyx-text-2);
    }
    .dl-older {
        margin: 1.75rem 0 0;
        font-size: 0.94rem;
    }
    .dl-notes ul {
        list-style: none;
        padding: 0;
        margin: 2.5rem 0 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }
    .dl-notes li {
        border-top: 1px solid var(--onyx-line-2);
        padding-top: 1.1rem;
    }
    .dl-notes h3 {
        font-size: 1.05rem;
        margin: 0 0 0.4rem;
    }
    .dl-notes p {
        margin: 0;
        color: var(--onyx-text-2);
        font-size: 0.96rem;
    }
    .dl-next {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        margin-top: 3.5rem;
        padding: 1.75rem 2rem;
        border-radius: var(--onyx-radius-lg);
        background: var(--onyx-surface);
        border: 1px solid var(--onyx-line);
    }
    .dl-next p {
        margin: 0;
        color: var(--onyx-text-2);
        max-width: 40rem;
    }
    @media (max-width: 760px) {
        .dl-row {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }
        .dl-notes ul {
            grid-template-columns: 1fr;
        }
    }
</style>
