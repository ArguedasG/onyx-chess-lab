{
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "copyright": "",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "publisher": "Francisco Salgueiro",
    "shortDescription": "Local-first chess study and training lab",
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": {
      "../sound/": "sound/",
      "resources/endgames/FinalesParte1.pgn": "training/endgames/FinalesParte1.pgn",
      "resources/endgames/FinalesParte2.pgn": "training/endgames/FinalesParte2.pgn",
      "resources/endgames/FinalesParte3.pgn": "training/endgames/FinalesParte3.pgn"
    },
    "targets": "all",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeDevCommand": "pnpm start-vite",
    "beforeBuildCommand": "pnpm build-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "productName": "Onyx Chess Lab",
  "mainBinaryName": "onyx-chess-lab",
  "identifier": "org.encroissant.app",
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Onyx Chess Lab",
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}
